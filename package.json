{
  "name": "memloom",
  "version": "0.1.0",
  "private": true,
  "description": "把 AI Agent 干活攒下的零散经历，织成真正管用、人也能一眼看懂的工作原则",
  "bin": {
    "memloom": "dist/src/cli/main.js",
    "memloom-mcp": "dist/src/mcp/main.js"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --import ./tests/fixtures/offline-preload.mjs \"dist/tests/*.test.js\"",
    "test:real-model": "npm run build && node --test dist/tests/retriever-real-model.test.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-node": "1.31.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
